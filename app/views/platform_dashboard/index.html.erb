<section>
  <h1><%= t('platform_access.dashboard_title') %></h1>
  <p><%= t('platform_access.dashboard_description') %></p>
</section>
<div class="platform-grid">
  <section class="platform-metric"><h2><%= t('p0_auth.organizations') %></h2><strong><%= @organization_count %></strong></section>
  <section class="platform-metric"><h2><%= t('p0_auth.users') %></h2><strong><%= @user_count %></strong></section>
  <section class="platform-metric"><h2><%= t('p0_auth.memberships') %></h2><strong><%= @active_memberships %></strong></section>
</div>
<div class="platform-grid">
  <section class="platform-metric"><h2><%= t('platform_mgmt.active') %></h2><strong><%= @active_organizations %></strong></section>
  <section class="platform-metric"><h2><%= t('platform_mgmt.staging') %></h2><strong><%= @staged_organizations %></strong></section>
  <section class="platform-metric"><h2><%= t('platform_mgmt.suspended') %></h2><strong><%= @suspended_organizations %></strong></section>
</div>
<p><%= link_to t('platform_mgmt.organizations'), platform_organizations_path %> ·
<%= link_to t('platform_mgmt.audit'), platform_audit_events_path %></p>
<section class="platform-panel">
  <p><%= t('platform_access.no_tenant_access') %></p>
  <%= button_to t('platform_access.sign_out'), platform_sign_out_path, method: :delete %>
</section>
