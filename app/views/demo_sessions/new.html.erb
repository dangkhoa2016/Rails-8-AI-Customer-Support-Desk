<section class="hero">
  <span class="pill"><%= t('auth.title') %></span>
  <h1><%= t('auth.headline') %></h1>
  <p class="intro"><%= t('auth.explain') %></p>
</section>
<section class="two">
  <div class="panel">
    <h2><%= t('auth.select_agent') %></h2>
    <% if @memberships.any? %>
      <%= form_with url: demo_sign_in_path, method: :post do |f| %>
        <div class="field">
          <%= f.label :membership_id, t('auth.identity') %>
          <%= select_tag :membership_id, options_from_collection_for_select(@memberships, :id, :display_label), required: true %>
        </div>
        <div class="field"><%= label_tag :locale, t('auth.language') %><%= select_tag :locale, options_for_select([['Tiếng Việt','vi'], ['English','en']], I18n.locale.to_s) %></div>
        <%= f.submit t('auth.sign_in') %>
      <% end %>
    <% else %>
      <div class="badge-empty"><%= t('auth.no_memberships') %></div>
    <% end %>
  </div>
  <div class="panel">
    <h2><%= t('auth.security_title') %></h2>
    <p class="muted"><%= t('auth.security_explain') %></p>
    <span class="pill warn"><%= t('auth.dev_only') %></span>
  </div>
</section>
