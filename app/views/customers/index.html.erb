<div class="hero"><h1><%= t('customers.heading') %></h1><p class="intro"><%= t('customers.subtitle') %></p></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th><%= t('customers.key') %></th><th><%= t('customers.name') %></th><th><%= t('customers.locale') %></th></tr></thead><tbody>
