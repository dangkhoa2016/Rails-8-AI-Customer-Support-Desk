<%= link_to t('nav.tickets'), tickets_path, class: 'back' %>
<%= render 'summary', ticket: @ticket %>
<div class="two">
  <%= render 'conversation', messages: @messages %>
  <div class="stack">
    <section class="panel">
      <h2><%= t('tickets.case_context') %></h2>
      <p class="tiny muted"><%= t('tickets.synthetic_notice') %></p>
      <p><strong><%= t('tickets.customer') %>:</strong> <%= @ticket.customer.external_key %> · <%= @ticket.customer.locale.upcase %></p>
      <p><strong><%= t('tickets.reference') %>:</strong> <span class="mono"><%= @ticket.business_ref.presence || '—' %></span></p>
      <% if can_write? && @ticket.business_ref.present? %>
        <% if current_organization.vertical == 'b2b_saas' && @ticket.business_ref.start_with?('TF-INV-') %>
          <p><%= link_to t('tickets.inspect_reference'), teamflow_invoice_path(customer_key: @ticket.customer.external_key, invoice_number: @ticket.business_ref), class: 'btn secondary' %></p>
        <% elsif current_organization.vertical == 'ecommerce' && @ticket.business_ref.start_with?('NM-2026-') %>
          <p><%= link_to t('tickets.inspect_reference'), novamart_order_path(customer_key: @ticket.customer.external_key, order_number: @ticket.business_ref), class: 'btn secondary' %></p>
        <% end %>
      <% end %>
      <% if can_write? %>
        <p><%= link_to t('tickets.manual_kb_search'), kb_ai_search_path, class: 'btn secondary' %></p>
        <p class="tiny muted"><%= t('tickets.relevance_only') %></p>
      <% end %>
    </section>
    <% if can?(:ticket_assign) %>
      <section class="panel">
        <h2><%= t('tickets.assign_ticket') %></h2>
        <%= form_with url: assign_ticket_path(@ticket), method: :patch do %>
          <div class="field"><%= label_tag :assignee_user_id, t('tickets.assignee') %>
            <%= select_tag :assignee_user_id, options_for_select(
              [[t('tickets.unassigned'), '']] +
              @available_assignees.map { |member| [member.user.display_name.presence || member.user.email, member.user_id.to_s] },
              @ticket.assignee_id&.to_s) %></div>
          <%= submit_tag t('tickets.assign_save'), class: 'btn secondary' %>
        <% end %>
      </section>
    <% end %>
    <% if can_write? %>
      <%= render 'reply_form', ticket: @ticket %>
      <%= render 'status_controls', ticket: @ticket %>
    <% end %>
  </div>
</div>
